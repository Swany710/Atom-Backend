# ─────────────────────────────────────────────────────────────────────────────
# Atom Backend — Environment Variable Template
# Copy this to .env and fill in every value.
# In production set these in Railway — never commit .env
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
JWT_SECRET=
# Token lifetime — default 24h. Tokens live in browser localStorage, so keep short.
JWT_EXPIRES_IN=24h
OWNER_USER_ID=

# ── Supabase / Database ───────────────────────────────────────────────────────
#
# Find your project ref and URL in: Supabase Dashboard → Settings → API
#
# TWO connection string options — use Transaction Pooler for Railway (recommended):
#
# Option A — Transaction Pooler (port 6543) ← USE THIS FOR RAILWAY
#   Handles connection spikes, no persistent connections needed.
#   Does NOT support prepared statements (handled automatically).
#   Copy the Transaction pooler string from Supabase Dashboard -> Connect.
#   The pooler host is region-specific; do not leave aws-0-us-east-1 unless
#   Supabase gave you that exact host.
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres
#
# Option B — Direct Connection (port 5432) ← use for local dev / migrations
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres

# SSL — Supabase always requires SSL.
# DATABASE_TLS_STRICT=true verifies the server certificate (recommended in
# production — protects DB traffic from man-in-the-middle attacks).
# Supabase uses its own CA, so strict mode needs the CA cert. Download it from
# Supabase Dashboard → Settings → Database → SSL, then set ONE of:
#   DATABASE_CA_CERT       — paste the full PEM contents (Railway-friendly)
#   DATABASE_CA_CERT_PATH  — path to the .crt/.pem file on disk
DATABASE_SSL=true
DATABASE_TLS_STRICT=true
DATABASE_CA_CERT=
# supabase-prod-ca.crt is committed at the repo root (Supabase Intermediate +
# Root 2021 CA, extracted from the live pooler TLS handshake — public cert).
DATABASE_CA_CERT_PATH=supabase-prod-ca.crt

# Max pooled DB connections PER NODE PROCESS.
# Leave unset to use the defaults (20 behind the Supabase transaction pooler,
# 10 on a direct connection). The real ceiling is this value × replica count,
# and blowing past the Postgres connection limit fails every query at once —
# so raise it when you add replicas or observe pool saturation, not by reflex.
DATABASE_POOL_MAX=

# Number of trusted reverse proxies in front of this service.
# Without this, Express reports the proxy's address as req.ip for every request
# and IP-based rate limiting collapses into one shared bucket for everybody.
#
# Defaults: 1 in production (the atom-frontend proxy), 0 everywhere else.
# Add a hop for each additional CDN/proxy you put in front.
#
# Set it too HIGH and a client can pick its own rate-limit bucket by sending
# its own X-Forwarded-For — Express will believe a header nobody trustworthy
# wrote. Set it too LOW and everyone shares a bucket. Too low is the safe
# direction to be wrong in, which is why the non-production default is 0.
TRUST_PROXY_HOPS=1

# Supabase API keys (from Settings → API in Supabase dashboard)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# SUPABASE_SERVICE_ROLE_KEY= ← set in Railway only, never commit

# ── Token encryption ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MUST match EXACTLY what is registered with the provider AND the route the app
# actually serves. There is ONE OAuth callback for both Google and Microsoft:
#     <backend-origin>/email/oauth/callback
# (EmailOAuthController @Controller('email/oauth') @Get('callback'), and main.ts
# sets no global prefix). The provider is recovered from the signed state, not
# from the path — so do NOT invent per-provider callback paths. Earlier versions
# of this file documented /integrations/... paths that the app never served;
# registering those gives a 404 after consent, with no useful error.
GOOGLE_REDIRECT_URI=http://localhost:3000/email/oauth/callback
# Optional comma-separated scope override. Defaults cover Gmail, Calendar and
# read-only Contacts. NOTE: contacts search uses the Google PEOPLE API, which
# must also be ENABLED on the Google Cloud project — the scope alone is not
# enough. Anyone who connected Gmail before contacts support was added must
# reconnect once; a refresh token only carries the scopes it was issued with.
GOOGLE_SCOPES=

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Same single callback as Google — see the note above GOOGLE_REDIRECT_URI.
MICROSOFT_REDIRECT_URI=http://localhost:3000/email/oauth/callback
# Optional comma-separated scope override. Defaults cover Mail, Calendars and
# read-only Contacts. Same reconnect caveat as Google above.
MICROSOFT_SCOPES=

# ── OpenAI — EMBEDDINGS ONLY ──────────────────────────────────────────────────
# PROVIDER POLICY: OpenAI is used for text-embedding-3-small and nothing else
# (knowledge-base product spec library, KnowledgeBaseService). It is NOT a
# speech provider and NOT a reasoning provider:
#     speech in/out  → ElevenLabs
#     reasoning+tools → Anthropic (Claude)
#     embeddings      → OpenAI
# Do not add OpenAI fallbacks to the speech path. If ElevenLabs is down, voice
# is down — that is the intended behaviour.
OPENAI_API_KEY=

# ── ElevenLabs — the ONLY speech-to-text + text-to-speech provider ────────────
# Powers POST /api/v1/ai/voice (STT) and POST /api/v1/ai/speak (TTS).
# REQUIRED: without it, voice input and every spoken reply fail. There is no
# fallback to another vendor, by design.
ELEVENLABS_API_KEY=
# Optional — overrides the OpenAI-voice-name → ElevenLabs-voice mapping
ELEVENLABS_VOICE_ID=
# Optional — defaults below
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used by the orchestrator (optional — defaults to claude-sonnet-4-5-20250929)
CLAUDE_MODEL=
# Output token budget per call (optional — default 4096). Raise if long
# summaries get cut off; lower to cap per-request cost.
CLAUDE_MAX_TOKENS=
# Max tool-use round trips per user turn (optional — default 12). Guards against
# a runaway tool loop burning spend on a single request.
CLAUDE_MAX_TOOL_ITERATIONS=
# Model used to compact conversation turns that scroll out of the 40-message
# history window (optional — defaults to claude-haiku-4-5-20251001).
# Kept separate from CLAUDE_MODEL so upgrading the conversational model doesn't
# silently change summarisation cost on every rollover.
CLAUDE_SUMMARY_MODEL=

# ── Email provider ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=gmail

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081
